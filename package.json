{
  "name": "snocommit",
  "version": "0.1.1",
  "description": "A Simple way to commit changes in current folder.",
  "keywords": [
    "cli",
    "commit",
    "git"
  ],
  "homepage": "https://github.com/snomiao/snocommit#readme",
  "bugs": {
    "url": "https://github.com/snomiao/snocommit/issues?q=is%3Aissue+is%3Aopen+snocommit"
  },
  "license": "MIT",
  "author": "snomiao <snomiao@gmail.com>",
  "repository": "https://github.com/snomiao/snocommit",
  "bin": {
    "chore": "dist/cli-chore.js",
    "docs": "dist/cli-docs.js",
    "feat": "dist/cli-feat.js",
    "fix": "dist/cli-fix.js",
    "refactor": "dist/cli-refactor.js",
    "snocommit": "dist/cli-snocommit.js",
    "styles": "dist/cli-styles.js"
  },
  "files": [
    "*.ts",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.min.cjs",
  "module": "index.ts",
  "types": "./index.ts",
  "exports": {
    "types": "./src/index.ts",
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts src/index.tsx --outdir dist --target=node --external=openai --external=zod --sourcemap",
    "postbuild": "bun postbuild.ts",
    "prepack": "npm run build",
    "fmt": "bunx oxlint --fix && bunx oxfmt",
    "prerelease": "bun run build && bun run test",
    "release": "bun x commit-and-tag-version && git push --follow-tags && npm publish",
    "test": "bun test",
    "prepare": "lefthook install",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "openai": "^6.15.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@types/bun": "^1.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "25.0.3",
    "lefthook": "^2.0.13",
    "p-map": "^7.0.4",
    "package-up": "^5.0.0",
    "phpdie": "^1.7.0",
    "semantic-release": "^25.0.2",
    "snorun": "^1.7.1",
    "tsa-composer": "^3.0.3",
    "typescript": "^5.9.3",
    "z-chat-completion": "^0.1.8"
  },
  "overrides": {
    "glob": ">=11.1.0",
    "js-yaml": ">=4.1.1",
    "tar": ">=7.5.2"
  }
}
